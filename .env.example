# ======================================================================
#  羽毛球报名 Agent 配置示例
#  复制为 .env 并填入真实值：  cp .env.example .env
# ======================================================================

# ---- Google Sheets ----
# 报名表 URL 里 /d/ 和 /edit 之间那一段就是 SPREADSHEET_ID
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit#gid=0
SPREADSHEET_ID=your_spreadsheet_id_here
# 工作表(标签页)名称，注意大小写
SHEET_NAME=Sheet1
# 服务账号 JSON 凭证路径。把服务账号邮箱以“编辑者”身份共享给这张表。
GOOGLE_CREDENTIALS_FILE=./credentials/service_account.json

# ---- 表格结构 ----
# 第一个 Player 列的字母(截图里 Player 1 在 E 列)
PLAYER_FIRST_COL=E
# 每个场地的报名位置数量
PLAYER_COUNT=24
# 表头所在行(DayOfWeek/Date/Time/Field 和 Player 1.. 所在行)
HEADER_ROW=2
# 数据(场地)起始行
DATA_START_ROW=3
# 一次最多扫描多少行数据
MAX_DATA_ROWS=200

# ---- 报名对象 ----
# 逗号分隔，顺序即优先级(位置不足时靠前的先报)
REGISTER_NAMES=alice,bob

# ---- 时间/日期解析 ----
TIMEZONE=Europe/Brussels
# 日期只有 d/m 时用哪个年份；留空=按当前时间智能推断(跨年场景自动 +1 年)
DEFAULT_YEAR=

# ---- 轮询 ----
POLL_INTERVAL_SECONDS=20
POLL_JITTER_SECONDS=5

# ---- 并发/写入 ----
MAX_RETRIES=5
WRITE_RETRY_JITTER_MS_MIN=50
WRITE_RETRY_JITTER_MS_MAX=400

# ---- 状态与日志 ----
STATE_DB=./data/state.db
LOG_FILE=./data/agent.log
LOG_LEVEL=INFO

# ---- 安全开关 ----
# true = 只读、只打印将要写入的内容，绝不真正写表(强烈建议首次运行先开 true)
DRY_RUN=true

# ---- 邮件通知 (SMTP) ----
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=you@example.com
SMTP_TO=you@example.com
